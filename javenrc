########################################
# Javen Toolkit
# Version: v1.0
########################################

########################################
# Prompt
########################################

PS1='\[\e[38;5;223m\]\u@\h\[\e[0m\]:\[\e[38;5;110m\]\w\[\e[0m\] \[\e[38;5;151m\]>\[\e[0m\] '

########################################
# History
########################################

HISTSIZE=5000
HISTFILESIZE=5000

########################################
# Environment
########################################

export BAT_THEME="Nord"

########################################
# Alias
########################################

## bat
alias bat='batcat'
alias cat='bat --paging=never'

## ls
alias ls='ls --color=auto'
alias ll='ls -lah --color=auto'
alias la='ls -A --color=auto'

## grep
alias grep='grep --color=auto'

## clear
alias c='clear'
alias cls='clear'

## history
alias h='history'

## reload
alias reload='source ~/.bashrc'
alias edit='nano ~/.javenrc'

## navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

## subscribe
alias sub='cd /root/subscribe'
alias route='nano /root/subscribe/javen-routing-v1.yaml'

## update
alias update='apt update && apt upgrade -y'

## ecs 测试脚本 - 融合怪
alias ecs='bash /root/ecs.sh'

########################################
# grc Color
########################################

alias ping='grc ping'
alias ip='grc ip'
alias df='grc df'
alias free='grc free'

########################################
# Journal
########################################

jlog () {
    if [ -z "$1" ]; then
        journalctl -n 100 --no-pager | ccze -A
    else
        journalctl -u "$1" -n 100 --no-pager | ccze -A
    fi
}

jfollow () {
    journalctl -u "$1" -f | ccze -A
}

########################################
# Functions
########################################

unalias info 2>/dev/null

info () {
    echo
    echo "========== Javen Server =========="
    echo "Hostname : $(hostname)"
    echo "IP       : $(hostname -I | awk '{print $1}')"
    echo "Kernel   : $(uname -r)"
    echo

    echo "Memory"
    free -h
    echo

    echo "Disk"
    df -h /
    echo
}

########################################
# Dashboard
########################################

dashboard() {

    local HOSTNAME=$(hostname)
    local KERNEL=$(uname -r)
    local UPSEC=$(cut -d. -f1 /proc/uptime)

    local DAYS=$((UPSEC / 86400))
    local HOURS=$(((UPSEC % 86400) / 3600))

    local UPTIME

    if [ "$DAYS" -gt 0 ]; then
       UPTIME="${DAYS}d ${HOURS}h"
    else
        UPTIME="${HOURS}h"
    fi
    
    local MEMORY=$(free -h | awk '/Mem:/ {print $3 " / " $2}')
    local DISK=$(df -h / | awk 'NR==2 {print $3 " / " $2}')
    local IP=$(curl -fsS ipinfo.io/ip 2>/dev/null || echo "-")
    local NOW=$(date "+%Y-%m-%d %H:%M")
    local USERNAME=$(whoami)

    echo
    echo -e "\e[38;5;110m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\e[0m"
    echo
    echo -e "           \e[38;5;223mJaven Server\e[0m"
    echo
    printf "\e[38;5;110m %-10s\e[0m %s\n" "Hostname" "$HOSTNAME"
    printf "\e[38;5;110m %-10s\e[0m %s\n" "Public IP" "$IP"
    printf "\e[38;5;110m %-10s\e[0m %s\n" "Kernel" "$KERNEL"
    printf "\e[38;5;110m %-10s\e[0m %s\n" "Uptime" "$UPTIME"
    printf "\e[38;5;110m %-10s\e[0m %s\n" "Memory" "$MEMORY"
    printf "\e[38;5;110m %-10s\e[0m %s\n" "Disk" "$DISK"
    printf "\e[38;5;110m %-10s\e[0m %s\n" "Time" "$NOW"
    printf "\e[38;5;110m %-10s\e[0m %s\n" "User" "$USERNAME"
    echo
    echo -e "\e[38;5;110m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\e[0m"
    echo
}

########################################
# vivid themes
########################################

export LS_COLORS="$(vivid generate rose-pine-dawn)"

if [[ $- == *i* ]]; then
    dashboard
fi
